<?xml version="1.0" encoding="utf-8"?>
<!-- Pad 端线路选择对话框（sw600dp） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical">

        <!-- 两栏内容区(左右等分,与手机端一致) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:orientation="horizontal">

            <!-- 左：配置名列表(等分) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConfigs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent" />

            <!-- 分隔线 -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/dialog_panel_stroke" />

            <!-- 右：线路列表(等分) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRoutes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角 ✕ 关闭按钮:白底黑字 -->
    <TextView
        android:id="@+id/btnRouteClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginEnd="@dimen/vs_8"
        android:background="@drawable/button_danmu_close"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="@dimen/vs_12"
        android:paddingTop="@dimen/vs_6"
        android:paddingEnd="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_6"
        android:text="✕"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28" />
</FrameLayout>
