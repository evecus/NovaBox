<?xml version="1.0" encoding="utf-8"?>
<!-- Pad 端线路选择对话框（sw600dp） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical">

        <!-- 标题栏:左"配置" / 右"线路",两段宽度严格对应下方两栏,✕ 固定在标题栏右上角 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_10">

            <!-- 左标题格 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="配置"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_24"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 右标题格:含 ✕ 关闭按钮 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="线路"
                        android:textColor="@color/dialog_text_primary"
                        android:textSize="@dimen/ts_24"
                        android:textStyle="bold" />

                    <!-- ✕ 关闭按钮:固定在标题栏右上角 -->
                    <TextView
                        android:id="@+id/btnRouteClose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="@dimen/vs_4"
                        android:background="@drawable/button_danmu_close"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/vs_10"
                        android:paddingTop="@dimen/vs_4"
                        android:paddingEnd="@dimen/vs_10"
                        android:paddingBottom="@dimen/vs_4"
                        android:text="✕"
                        android:textColor="@color/dialog_text_primary"
                        android:textSize="@dimen/ts_26" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 标题与列表分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dialog_panel_stroke" />

        <!-- 两栏内容区(左右等分) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:orientation="horizontal">

            <!-- 左：配置名列表(等分) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConfigs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent" />

            <!-- 分隔线 -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/dialog_panel_stroke" />

            <!-- 右：线路列表(等分) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRoutes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
