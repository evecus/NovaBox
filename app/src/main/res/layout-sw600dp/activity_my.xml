<?xml version="1.0" encoding="utf-8"?>
<!--
    Pad 端“我的”页面布局（sw600dp）
    与首页/直播同级，左侧竖向导航栏（72dp 宽）；
    功能入口改为竖向列表展示，非卡片网格。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══════════════════════════════════════════
         左侧导航栏（竖向，宽 96dp，与首页/直播页保持一致的放大尺寸）
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="96dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:background="@drawable/shape_side_nav_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <!-- 首页 -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/selector_nav_item_bg">
            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_video"
                android:alpha="0.5" android:tint="@android:color/black"/>
            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="首页"
                android:textColor="#80000000"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 直播 -->
        <LinearLayout
            android:id="@+id/navLive"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/selector_nav_item_bg">
            <ImageView
                android:id="@+id/navLiveIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_live"
                android:alpha="0.5" android:tint="@android:color/black"/>
            <TextView
                android:id="@+id/navLiveText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="直播"
                android:textColor="#80000000"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 我的（当前页，高亮） -->
        <LinearLayout
            android:id="@+id/navSetting"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/selector_nav_item_bg">
            <ImageView
                android:id="@+id/navSettingIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_my"
                android:alpha="1.0" android:tint="#0CADE2"/>
            <TextView
                android:id="@+id/navSettingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="我的"
                android:textColor="#0CADE2"
                android:textSize="14sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         右侧主内容区
         ═══════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/bottomNavLayout"
        app:layout_constraintRight_toRightOf="parent">

        <!-- 功能入口（竖向列表，适配平板横屏） -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- OpenList 网盘入口 -->
            <LinearLayout
                android:id="@+id/btnOpenList"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/shape_my_item_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/icon_openlist_cloud"
                    android:tint="@android:color/black"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="OpenList 网盘"
                    android:textColor="@android:color/black"
                    android:textSize="17sp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_back"
                    android:tint="@android:color/black"
                    android:rotation="180"/>
            </LinearLayout>

            <!-- 本地视频入口 -->
            <LinearLayout
                android:id="@+id/btnLocalVideo"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_my_item_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/icon_local_video"
                    android:tint="@android:color/black"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="本地视频"
                    android:textColor="@android:color/black"
                    android:textSize="17sp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_back"
                    android:tint="@android:color/black"
                    android:rotation="180"/>
            </LinearLayout>

            <!-- 本地音乐入口 -->
            <LinearLayout
                android:id="@+id/btnLocalAudio"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_my_item_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="@android:color/black"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="本地音乐"
                    android:textColor="@android:color/black"
                    android:textSize="17sp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_back"
                    android:tint="@android:color/black"
                    android:rotation="180"/>
            </LinearLayout>

            <!-- 下载管理入口（本地音乐下面） -->
            <LinearLayout
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_my_item_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/icon_download"
                    android:tint="@android:color/black"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="下载管理"
                    android:textColor="@android:color/black"
                    android:textSize="17sp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_back"
                    android:tint="@android:color/black"
                    android:rotation="180"/>
            </LinearLayout>

            <!-- 设置入口 -->
            <LinearLayout
                android:id="@+id/btnSetting"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_my_item_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/icon_setting"
                    android:tint="@android:color/black"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="设置"
                    android:textColor="@android:color/black"
                    android:textSize="17sp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_back"
                    android:tint="@android:color/black"
                    android:rotation="180"/>
            </LinearLayout>

            <!-- 数据备份入口（从设置页移到这里，放设置按钮底部） -->
            <LinearLayout
                android:id="@+id/btnBackup"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_my_item_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/icon_setting"
                    android:tint="@android:color/black"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="数据备份"
                    android:textColor="@android:color/black"
                    android:textSize="17sp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_back"
                    android:tint="@android:color/black"
                    android:rotation="180"/>
            </LinearLayout>

            <!-- 关于入口（从设置页移到这里，放数据备份底部） -->
            <LinearLayout
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_my_item_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/icon_setting"
                    android:tint="@android:color/black"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="关于"
                    android:textColor="@android:color/black"
                    android:textSize="17sp"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_back"
                    android:tint="@android:color/black"
                    android:rotation="180"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
