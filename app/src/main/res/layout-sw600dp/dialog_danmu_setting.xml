<?xml version="1.0" encoding="utf-8"?>
<!--
    Pad 端弹幕设置对话框（sw600dp）
    与手机端(dialog_danmu_setting.xml)保持相同的控件 id，宽度放大到 580dp
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="580dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:paddingLeft="36dp"
        android:paddingTop="28dp"
        android:paddingRight="36dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:singleLine="true"
            android:text="弹幕设置"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <!-- 弹幕开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical|right"
                android:text="弹幕开关"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trv_onoff"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 弹幕颜色 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical|right"
                android:text="弹幕颜色"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trv_color"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 弹幕速度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical|right"
                android:text="弹幕速度"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/speed"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 弹幕大小 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical|right"
                android:text="弹幕大小"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/sizeSub"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:background="@drawable/button_danmu_setting"
                    android:gravity="center"
                    android:focusable="true"
                    android:text="-"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_24" />
                <TextView
                    android:id="@+id/size"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />
                <TextView
                    android:id="@+id/sizeAdd"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:background="@drawable/button_danmu_setting"
                    android:gravity="center"
                    android:focusable="true"
                    android:text="+"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_24" />
            </LinearLayout>
        </LinearLayout>

        <!-- 弹幕屏占比 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical|right"
                android:text="屏占比"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/ratioSub"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:background="@drawable/button_danmu_setting"
                    android:gravity="center"
                    android:focusable="true"
                    android:text="-"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_24" />
                <TextView
                    android:id="@+id/ratio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />
                <TextView
                    android:id="@+id/ratioAdd"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:background="@drawable/button_danmu_setting"
                    android:gravity="center"
                    android:focusable="true"
                    android:text="+"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_24" />
            </LinearLayout>
        </LinearLayout>

        <!-- 弹幕透明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical|right"
                android:text="弹幕透明"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_50"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/alphaSub"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:background="@drawable/button_danmu_setting"
                    android:gravity="center"
                    android:focusable="true"
                    android:text="-"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_24" />
                <TextView
                    android:id="@+id/alpha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />
                <TextView
                    android:id="@+id/alphaAdd"
                    android:layout_width="@dimen/vs_50"
                    android:layout_height="@dimen/vs_50"
                    android:layout_gravity="center"
                    android:background="@drawable/button_danmu_setting"
                    android:gravity="center"
                    android:focusable="true"
                    android:text="+"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_24" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
