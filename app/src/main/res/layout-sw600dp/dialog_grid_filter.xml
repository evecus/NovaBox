<?xml version="1.0" encoding="utf-8"?>
<!--
    筛选弹窗（Pad 端，sw600dp）
    改动：原来从右侧整高弹出（宽 380dp、贴边），现改为与手机端一致的
    居中白色卡片风格，只是卡片宽度固定为 560dp（居中显示更美观，
    不会像手机端那样铺满，也不会像旧版一样贴边占满整高）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/filterCard"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_filter_bg"
        android:orientation="vertical">

        <!-- 标题栏：标题 + 右上角关闭按钮 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/vs_20"
            android:paddingRight="@dimen/vs_15"
            android:paddingTop="@dimen/vs_15"
            android:paddingBottom="@dimen/vs_10">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="筛选"
                android:textColor="@color/color_000000"
                android:textStyle="bold"
                android:textSize="@dimen/ts_26" />

            <ImageView
                android:id="@+id/btnFilterClose"
                android:layout_width="@dimen/vs_35"
                android:layout_height="@dimen/vs_35"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:padding="@dimen/vs_8"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_close" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A000000" />

        <LinearLayout
            android:id="@+id/filterRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_20"
            android:paddingRight="@dimen/vs_20"
            android:paddingTop="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_20" />

    </LinearLayout>
</FrameLayout>
