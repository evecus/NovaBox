<?xml version="1.0" encoding="utf-8"?>
<!--
    首页内容 Fragment(Pad sw600dp 版)。
    左侧导航栏已上移到容器 MainActivity,此处只保留右侧主内容区。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶部栏：线路 + 站源切换 + 搜索框 + 收藏 + 历史 -->
    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 线路选择按钮 -->
        <LinearLayout
            android:id="@+id/btnRoute"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:background="@drawable/shape_source_btn_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="线路"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:alpha="0.7"
                android:src="@drawable/icon_back"
                android:tint="@android:color/black"
                android:rotation="-90"/>
        </LinearLayout>

        <!-- 站源切换按钮 -->
        <LinearLayout
            android:id="@+id/btnSiteSwitch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:background="@drawable/shape_source_btn_bg">
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="站源"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:alpha="0.7"
                android:src="@drawable/icon_back"
                android:tint="@android:color/black"
                android:rotation="-90"/>
        </LinearLayout>

        <!-- 搜索框(占满剩余空间,加宽) -->
        <LinearLayout
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/shape_search_bar_bg">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.7"
                android:tint="@android:color/black"
                android:src="@drawable/icon_search"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="搜索影视..."
                android:textColor="#AA000000"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 收藏图标 -->
        <ImageView
            android:id="@+id/btnCollect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/icon_collect"
            android:tint="@android:color/black"
            android:alpha="0.85"/>

        <!-- 历史图标 -->
        <ImageView
            android:id="@+id/btnHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="4dp"
            android:padding="8dp"
            android:src="@drawable/icon_history"
            android:tint="@android:color/black"
            android:alpha="0.85"/>

    </LinearLayout>

    <!-- 分类 Tab 横向列表（Pad 端字号放大，行高相应加高） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridView"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clipToPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout"/>

    <!-- 内容 ViewPager（占满剩余空间） -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mGridView">

        <com.mobile.novabox.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
