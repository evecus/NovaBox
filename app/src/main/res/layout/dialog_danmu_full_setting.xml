<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 弹窗右上角 X 关闭按钮:放在外层 FrameLayout 内,layout_gravity=top|end,
         paddingTop/paddingEnd 跟主容器 padding 对齐,确保视觉上"贴角"。 -->
    <TextView
        android:id="@+id/btnDanmuClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginEnd="@dimen/vs_8"
        android:background="@drawable/button_danmu_setting"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="@dimen/vs_12"
        android:paddingTop="@dimen/vs_6"
        android:paddingEnd="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_6"
        android:text="×"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_20"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_20"
        android:paddingBottom="@dimen/vs_20">

        <!-- 左侧：竖向设置项列表 -->
        <LinearLayout
            android:layout_width="@dimen/vs_120"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_10"
                android:gravity="center"
                android:text="弹幕设置"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llDanmuItemList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 中间分隔线 -->
        <View
            android:layout_width="@dimen/vs_2"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_12"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginRight="@dimen/vs_12"
            android:layout_marginBottom="@dimen/vs_4"
            android:background="#44FFFFFF" />

        <!-- 右侧：当前设置项的竖向列表选项 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDanmuPanelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_15"
                android:gravity="center"
                android:text="弹幕地址"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 弹幕地址 -->
                <LinearLayout
                    android:id="@+id/panelApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <EditText
                        android:id="@+id/inputApi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_dialog_api_input"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingLeft="@dimen/vs_2"
                        android:paddingTop="@dimen/vs_10"
                        android:paddingRight="@dimen/vs_2"
                        android:paddingBottom="@dimen/vs_10"
                        android:singleLine="true"
                        android:textColor="@color/dialog_text_primary"
                        android:textColorHint="@color/dialog_text_hint"
                        android:textSize="@dimen/ts_22" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_15"
                        android:gravity="right"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/apiDefault"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="@dimen/vs_10"
                            android:background="@drawable/button_danmu_setting"
                            android:focusable="true"
                            android:gravity="center"
                            android:padding="@dimen/vs_10"
                            android:text="默认"
                            android:textColor="@color/dialog_text_primary"
                            android:textSize="@dimen/ts_22" />

                        <TextView
                            android:id="@+id/apiSubmit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/button_danmu_setting"
                            android:focusable="true"
                            android:gravity="center"
                            android:padding="@dimen/vs_10"
                            android:text="确定"
                            android:textColor="@color/dialog_text_primary"
                            android:textSize="@dimen/ts_22" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 弹幕开关 -->
                <LinearLayout
                    android:id="@+id/panelOnOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_360"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llOnOffOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- 弹幕颜色 -->
                <LinearLayout
                    android:id="@+id/panelColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_360"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llColorOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- 弹幕字号 -->
                <LinearLayout
                    android:id="@+id/panelSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_360"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llSizeOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- 屏占比 -->
                <LinearLayout
                    android:id="@+id/panelRatio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_360"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llRatioOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- 滚动速度 -->
                <LinearLayout
                    android:id="@+id/panelSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_360"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llSpeedOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- 透明度 -->
                <LinearLayout
                    android:id="@+id/panelAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_360"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llAlphaOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- 行间距 -->
                <LinearLayout
                    android:id="@+id/panelLineSpacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/vs_360"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llLineSpacingOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
