<?xml version="1.0" encoding="utf-8"?>
<!--
    弹幕设置弹窗（单页纵向列表样式，对齐 NovaTV 版本）：
    开关/颜色/速度 用横排按钮组，字号/行数/透明度/行间距/顶边距 用"－ 数值 ＋"步进器，
    所有设置项一次性展示在同一页，不再有左侧菜单 + 右侧面板的切换逻辑。
    背景(shape_danmu_setting_bg)、文字颜色(dialog_text_primary 等)保持不变；
    右上角 ✕ 关闭按钮保留（手机触屏场景，NovaTV 靠遥控器返回键不需要）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 整体可滚动容器：手机横屏/小屏可用高度不足时，内容可上下滑动看到全部设置项 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_danmu_setting_bg"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_28"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_28">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_20"
                android:gravity="center"
                android:text="弹幕设置"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24"
                android:textStyle="bold" />

            <!-- 在线搜索：仅播放页弹窗（有剧集上下文）显示，设置页弹窗不显示；
                 点击直接弹出 SearchDanmuDialog，与"开关"同样的一行一个按钮的样式 -->
            <LinearLayout
                android:id="@+id/rowSearchOnline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="搜索"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/btnSearchOnline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/button_danmu_setting"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="@dimen/vs_12"
                    android:paddingBottom="@dimen/vs_12"
                    android:text="在线搜索"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <!-- 开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="开关"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <LinearLayout
                    android:id="@+id/llSwitchOptions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 颜色 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="颜色"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <LinearLayout
                    android:id="@+id/llColorOptions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 速度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="速度"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <LinearLayout
                    android:id="@+id/llSpeedOptions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 字号 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="字号"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <include
                    android:id="@+id/stepperSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/item_danmu_stepper" />
            </LinearLayout>

            <!-- 行数（替代原来的屏占比） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="行数"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <include
                    android:id="@+id/stepperLine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/item_danmu_stepper" />
            </LinearLayout>

            <!-- 透明度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="透明度"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <include
                    android:id="@+id/stepperAlpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/item_danmu_stepper" />
            </LinearLayout>

            <!-- 行间距 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="行间距"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <include
                    android:id="@+id/stepperLineSpacing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/item_danmu_stepper" />
            </LinearLayout>

            <!-- 顶边距 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="顶边距"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <include
                    android:id="@+id/stepperTopMargin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/item_danmu_stepper" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 弹窗右上角 ✕ 关闭按钮：白底黑字，固定悬浮（不随内容滚动），样式不变。
         必须放在 NestedScrollView 之后声明，确保绘制在最上层不被内容遮挡 -->
    <TextView
        android:id="@+id/btnDanmuClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginEnd="@dimen/vs_8"
        android:background="@drawable/button_danmu_close"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="@dimen/vs_12"
        android:paddingTop="@dimen/vs_6"
        android:paddingEnd="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_6"
        android:text="✕"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28" />
</FrameLayout>
