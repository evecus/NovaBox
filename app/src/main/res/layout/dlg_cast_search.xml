<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="投屏到设备"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCastRefresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="刷新"
                android:textColor="#FF1890FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCastClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="✕"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dialog_panel_stroke"
            android:layout_marginBottom="8dp" />

        <!-- 搜索状态提示 -->
        <TextView
            android:id="@+id/tvCastStatus"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="正在搜索局域网设备..."
            android:textColor="#80000000"
            android:textSize="14sp" />

        <!-- 设备列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCastDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="240dp"
            android:scrollbars="none" />

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dialog_panel_stroke" />

        <!-- 底部按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCastCancel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="取消"
                android:textColor="#FF333333"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
