<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_danmu_setting_bg">

    <!-- 内容区：可滚动，右侧预留空间给关闭按钮，避免遮挡文字 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/vs_600"
        android:paddingLeft="@dimen/vs_30"
        android:paddingRight="@dimen/vs_30"
        android:paddingTop="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_30"
        android:scrollbars="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/vs_30"
            android:lineSpacingExtra="@dimen/ts_50"
            android:lineSpacingMultiplier="0"
            android:text="开源地址:\nhttps://github.com/evecus/NovaBox"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24" />
    </ScrollView>

    <!-- 右上角关闭按钮 -->
    <ImageView
        android:id="@+id/btnAboutClose"
        android:layout_width="@dimen/vs_60"
        android:layout_height="@dimen/vs_60"
        android:layout_gravity="top|right"
        android:padding="@dimen/vs_12"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/icon_close"
        android:contentDescription="关闭" />

</FrameLayout>
