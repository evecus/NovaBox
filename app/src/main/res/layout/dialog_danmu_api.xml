<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_20"
        android:paddingTop="@dimen/vs_20"
        android:paddingRight="@dimen/vs_20"
        android:paddingBottom="@dimen/vs_20">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_15"
            android:gravity="center"
            android:text="弹幕地址"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_22"
            android:textStyle="bold" />

        <!-- 地址输入框 -->
        <EditText
            android:id="@+id/inputDanmuApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_dialog_api_input"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_2"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_2"
            android:paddingBottom="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_22" />

        <!-- 默认 / 确定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:gravity="right"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/danmuApiDefault"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="@dimen/vs_10"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="默认"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/danmuApiSubmit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="确定"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角 ✕ 关闭按钮:与弹幕设置弹窗保持一致的关闭交互 -->
    <TextView
        android:id="@+id/btnDanmuApiClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginEnd="@dimen/vs_8"
        android:background="@drawable/button_danmu_close"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="@dimen/vs_12"
        android:paddingTop="@dimen/vs_6"
        android:paddingEnd="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_6"
        android:text="✕"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28" />
</FrameLayout>
