<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/vs_360"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg">

        <TextView
            android:id="@+id/title"
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/ts_40"
            android:lineSpacingMultiplier="0"
            android:paddingLeft="@dimen/vs_20"
            android:paddingTop="@dimen/vs_12"
            android:paddingBottom="@dimen/vs_10"
            android:shadowColor="@color/color_000000_30"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:singleLine="true"
            android:text="数据备份与还原"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="@id/btnBackupClose"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="数据备份与还原" />

        <!-- 右上角关闭按钮 -->
        <ImageView
            android:id="@+id/btnBackupClose"
            android:layout_width="@dimen/vs_50"
            android:layout_height="@dimen/vs_50"
            android:padding="@dimen/vs_12"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_close"
            android:contentDescription="关闭"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <TextView
            android:id="@+id/tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/ts_30"
            android:lineSpacingMultiplier="0"
            android:paddingLeft="@dimen/vs_20"
            android:paddingRight="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_12"
            android:text="立即备份：选择一个目录，将当前数据打包保存为一个备份文件\n立即恢复：选择一个备份文件，恢复其中的数据（会覆盖当前数据）"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <LinearLayout
            android:id="@+id/backup_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_20"
            android:paddingRight="@dimen/vs_20"
            app:layout_constraintTop_toBottomOf="@id/tip">

            <TextView
                android:id="@+id/storagePermission"
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/vs_5"
                android:layout_marginRight="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_8"
                android:singleLine="true"
                android:text="存储权限"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/backupNow"
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/vs_5"
                android:layout_marginEnd="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_8"
                android:singleLine="true"
                android:text="立即备份"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/restoreNow"
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/vs_5"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_8"
                android:singleLine="true"
                android:text="立即恢复"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_20" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_12"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/backup_buttons" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
