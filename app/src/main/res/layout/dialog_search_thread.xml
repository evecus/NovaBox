<?xml version="1.0" encoding="utf-8"?>
<!--
    搜索线程数设置弹窗：样式参照 dialog_danmu_full_setting.xml（背景/文字颜色/步进器控件复用），
    单页纵向列表，两个数值项均用"－ 数值 ＋"步进器调节：
    - 线程池上限：真正决定能同时跑多少个源站搜索请求，是搜索速度的关键瓶颈。
    - 每批并发数：每次往线程池里投递的源站数量，不建议超过线程池上限（会被自动收敛）。
    右上角 ✕ 关闭按钮（触屏场景），底部"恢复默认"按钮一键还原。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_danmu_setting_bg"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_30"
            android:paddingTop="@dimen/vs_28"
            android:paddingRight="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_28">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_8"
                android:gravity="center"
                android:text="搜索线程数"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_20"
                android:gravity="center"
                android:text="数值越大搜索出结果越快，但会占用更多CPU/网络资源，低端设备或网络较差时建议调小"
                android:textColor="@color/dialog_text_hint"
                android:textSize="@dimen/ts_16" />

            <!-- 线程池上限：决定能同时跑多少个源站搜索请求，是搜索速度的关键瓶颈 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="线程池上限"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <include
                    android:id="@+id/stepperMaxThread"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/item_danmu_stepper" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_20"
                android:text="同时最多能有多少个源站在并发搜索，决定搜索速度的关键值"
                android:textColor="@color/dialog_text_hint"
                android:textSize="@dimen/ts_16" />

            <!-- 每批并发数：每次往线程池里投递的源站数量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="wrap_content"
                    android:text="每批并发数"
                    android:textColor="@color/dialog_text_primary"
                    android:textSize="@dimen/ts_20" />

                <include
                    android:id="@+id/stepperBatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/item_danmu_stepper" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_24"
                android:text="每次投递给线程池的源站数量，不会超过线程池上限"
                android:textColor="@color/dialog_text_hint"
                android:textSize="@dimen/ts_16" />

            <!-- 恢复默认 -->
            <TextView
                android:id="@+id/btnSearchThreadReset"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_48"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:text="恢复默认"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_18" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnSearchThreadClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/vs_8"
        android:layout_marginEnd="@dimen/vs_8"
        android:background="@drawable/button_danmu_close"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="@dimen/vs_12"
        android:paddingTop="@dimen/vs_6"
        android:paddingEnd="@dimen/vs_12"
        android:paddingBottom="@dimen/vs_6"
        android:text="✕"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_28" />
</FrameLayout>
